# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack dashboard → Settings → API Keys & Webhooks (test key to start)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Edge Function secrets (set with `supabase secrets set`, never put these in a .env the
# frontend reads — see 06-SUPABASE-DEPLOYMENT-CHECKLIST.md):
#   PAYSTACK_SECRET_KEY=sk_test_xxx
#   RESEND_API_KEY=re_xxx            — resend.com → API Keys
#   RESEND_FROM_EMAIL=noreply@yourdomain.com   — a domain verified in Resend
